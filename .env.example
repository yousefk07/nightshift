# DeepSeek: the only model provider
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_FLASH=deepseek-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_PRICE_FLASH_IN=0.3   (US$ per 1M tokens at peak; off-peak is half)

# Supabase (Project settings > API). Turn on email sign-in, and Google/Microsoft sign-in if wanted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64: openssl rand -base64 32. Encrypts stored tokens and keys; never change it once set.
ENCRYPTION_KEY=
# Long random string; the same one goes in supabase/cron.sql
CRON_SECRET=
# The deployed address (used for OAuth redirects and links in emails)
APP_URL=

# Nightshift's own email (alerts, invites, the morning brief): resend.com. Use an address on a verified domain.
RESEND_API_KEY=
RESEND_FROM=Nightshift <hello@yourdomain.com>

# Phone and laptop alerts (web push, free): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Nightshift admins (comma-separated): see every workspace at /admin, read-only, with the authenticator step on
ADMIN_EMAILS=
# ADMIN_REQUIRE_2FA=0   (lets admins in without the authenticator step; not recommended)

# Billing (Stripe Billing). Prices use lookup keys nightshift_<solo|studio|team|seat>_<month|year>.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint APP_URL/api/billing/webhook (subscription created/updated/deleted)
STRIPE_WEBHOOK_SECRET=
# REQUIRE_2FA_FOR_MONEY=0   (members with an authenticator must use it to approve money; 0 turns that off)

# Web search for Research and the watchers (tavily.com)
TAVILY_API_KEY=
# SEARCH_COST_USD=0.008  (counted against the daily budget per search)

# Connections. Each OAuth app's redirect is APP_URL/api/connect/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QBO_SANDBOX=1   (while testing against a QuickBooks sandbox company)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SALES_ACCOUNT=200
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
# Stripe (the business's own invoices), Shopify, HubSpot and Google Sheets connect with pasted keys or links.
# SHOPIFY_API_VERSION=2026-07
