# DeepSeek: the only model provider
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_FLASH=deepseek-v4.1-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_PRICE_FLASH_IN=0.3   (US$ per 1M tokens at peak; off-peak is half)

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may sign in (v1 is invite-only), comma separated
ALLOWED_EMAILS=

# 32 random bytes, base64: openssl rand -base64 32. Encrypts stored tokens and keys; never change it once set.
ENCRYPTION_KEY=
# Long random string; the same one goes in supabase/cron.sql
CRON_SECRET=
# The deployed address, e.g. https://nightshift.vercel.app (used for OAuth redirects)
APP_URL=

# Gmail + Google Calendar (Google Cloud console > OAuth client, redirect: APP_URL/api/connect/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 (Entra app registration, redirect: APP_URL/api/connect/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Web search for Research (tavily.com)
TAVILY_API_KEY=
# SEARCH_COST_USD=0.008  (counted against the daily budget per search)

# SHOPIFY_API_VERSION=2026-07
